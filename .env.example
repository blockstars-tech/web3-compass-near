# NEAR settings used by Web3 Compass. Nothing here is secret: every key is
# optional, and the values shown are the defaults in code. Copy to `.env` only
# if you change something; never commit a real `.env`.

# --- indexer -----------------------------------------------------------------
# Finds `.near` accounts that serve a web4 site (a `web4_get` contract method)
# with one read-only RPC view call per account. Opt-in.
NEAR_WEB4_ENABLED=false
# Free public endpoint. For a paid endpoint, set the URL and put its key in
# NEAR_RPC_API_KEY (sent as a Bearer token) in your own, uncommitted `.env`.
NEAR_RPC_URL=https://free.rpc.fastnear.com
NEAR_RPC_API_KEY=
NEAR_RPC_RPS=2
# Accounts checked per run (every minute), how long a check stays fresh, and
# how many checks run at once.
NEAR_WEB4_BATCH_SIZE=50
NEAR_WEB4_TTL_DAYS=7
NEAR_WEB4_CONCURRENCY=2

# --- scraper -----------------------------------------------------------------
# Sites are fetched over HTTPS from https://<account>.near.page, no proxy.
# How often an unchanged site is re-checked, and the fetch timeout.
NEAR_WEB4_SITE_TTL_SECONDS=21600
NEAR_WEB4_FETCH_TIMEOUT_MS=30000
# Link discovery (opt-in): `.near.page` links on indexed pages become candidate
# names, each verified on-chain by the indexer before it is treated as a site.
# At most MAX_PER_PAGE names per page; paused while MAX_UNCONFIRMED names are
# still unconfirmed.
NEAR_WEB4_DISCOVERY_ENABLED=false
NEAR_WEB4_DISCOVERY_MAX_PER_PAGE=50
NEAR_WEB4_DISCOVERY_MAX_UNCONFIRMED=2000

# --- gateway (dweb3.wtf) ------------------------------------------------------
# 'proxy' serves <account>.near.dweb3.wtf from near.page under our own domain;
# 'redirect' sends every request on to <account>.near.page instead.
WEB4_GATEWAY_MODE=proxy
